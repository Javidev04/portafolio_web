---
import Rutas from "../layouts/Rutas.astro";
---

<Rutas>
  <main class="min-h-[calc(100vh-5rem)] w-full px-3 py-10 sm:px-6 lg:px-10">
    <div class="relative z-10 mx-auto grid w-full max-w-4xl min-w-0 gap-10 rounded-4xl border border-slate-200/80 bg-white/80 p-4 shadow-2xl backdrop-blur dark:border-white/10 dark:bg-black/60 sm:p-8 md:grid-cols-[minmax(0,10fr)_minmax(0,1fr)]">
      <section class="min-w-0 space-y-6">
        <div>
          <p class="text-sm uppercase tracking-[0.32em] text-sky-600">Contacto</p>
          <h1 class="mt-2 text-4xl font-semibold text-slate-900 dark:text-white sm:text-5xl">Escríbeme un mensaje</h1>
        </div>

        <form class="w-full min-w-0 space-y-6" action="https://formspree.io/f/xnppogaw" method="POST">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="flex min-w-0 flex-col text-sm font-medium text-slate-700 dark:text-slate-200">
              Nombre
              <input
                name="name"
                type="text"
                placeholder="Tu nombre"
                required
                class="mt-2 block w-full min-w-0 max-w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-100 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:focus:border-sky-400 dark:focus:ring-sky-900/30"
              />
            </label>
            <label class="flex min-w-0 flex-col text-sm font-medium text-slate-700 dark:text-slate-200">
              Email
              <input
                name="email"
                type="email"
                placeholder="correo@ejemplo.com"
                required
                class="mt-2 block w-full min-w-0 max-w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-100 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:focus:border-sky-400 dark:focus:ring-sky-900/30"
              />
            </label>
          </div>

          <label class="flex min-w-0 flex-col text-sm font-medium text-slate-700 dark:text-slate-200">
            Mensaje
            <textarea
              name="message"
              rows="6"
              placeholder="Escribe tu mensaje aquí..."
              required
              class="mt-2 block w-full min-w-0 max-w-full resize-none rounded-2xl border border-slate-300 bg-slate-50 px-4 py-4 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-100 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:focus:border-sky-400 dark:focus:ring-sky-900/30"
            ></textarea>
          </label>

          <button
            type="submit"
            class="boton cursor-pointer inline-flex items-center justify-center rounded-xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/10 transition hover:bg-slate-800 dark:bg-sky-500 dark:text-slate-950 dark:hover:bg-sky-400"
          >
            Enviar mensaje
          </button>
        </form>
      </section>

      <aside class="py-8 dark:border-white/10 dark:bg-white/5">

        <div class="flex md:flex-col items-center justify-center">
          <a
            href="https://x.com/Javier_desu"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 bg-white p-4 rounded-full text-sm font-medium text-slate-900 transition hover:border-sky-300 hover:bg-sky-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-900 dark:hover:bg-slate-900"
          >
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-3xl bg-linear-to-br from-slate-900 via-slate-800 to-slate-700 text-white shadow-xl shadow-slate-900/20 ring-1 ring-slate-200 transition duration-300 hover:scale-105 dark:from-slate-100 dark:via-slate-200 dark:to-slate-300 dark:text-slate-950 dark:ring-slate-700/50 dark:group-hover:from-slate-200 dark:group-hover:via-slate-300 dark:group-hover:to-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 30" class="h-6 w-6 fill-current">
                <path d="M26.37,26l-8.795-12.822l0.015,0.012L25.52,4h-2.65l-6.46,7.48L11.28,4H4.33l8.211,11.971L12.54,15.97L3.88,26h2.65 l7.182-8.322L19.42,26H26.37z M10.23,6l12.34,18h-2.1L8.12,6H10.23z"></path>
                </svg>
            </span>
          </a>

          <a
            href="https://github.com/Javidev04"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 bg-white p-4 rounded-full text-sm font-medium text-slate-900 transition hover:border-sky-300 hover:bg-sky-50 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:hover:bg-slate-900"
          >
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-3xl bg-linear-to-br from-slate-900 via-slate-800 to-slate-700 text-white shadow-xl shadow-slate-900/20 ring-1 ring-slate-200 transition duration-300 hover:scale-105 dark:from-slate-100 dark:via-slate-200 dark:to-slate-300 dark:text-slate-950 dark:ring-slate-700/50 dark:group-hover:from-slate-200 dark:group-hover:via-slate-300 dark:group-hover:to-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 30" class="h-6 w-6 fill-current">
                    <path d="M15,3C8.373,3,3,8.373,3,15c0,5.623,3.872,10.328,9.092,11.63C12.036,26.468,12,26.28,12,26.047v-2.051 c-0.487,0-1.303,0-1.508,0c-0.821,0-1.551-0.353-1.905-1.009c-0.393-0.729-0.461-1.844-1.435-2.526 c-0.289-0.227-0.069-0.486,0.264-0.451c0.615,0.174,1.125,0.596,1.605,1.222c0.478,0.627,0.703,0.769,1.596,0.769 c0.433,0,1.081-0.025,1.691-0.121c0.328-0.833,0.895-1.6,1.588-1.962c-3.996-0.411-5.903-2.399-5.903-5.098 c0-1.162,0.495-2.286,1.336-3.233C9.053,10.647,8.706,8.73,9.435,8c1.798,0,2.885,1.166,3.146,1.481C13.477,9.174,14.461,9,15.495,9 c1.036,0,2.024,0.174,2.922,0.483C18.675,9.17,19.763,8,21.565,8c0.732,0.731,0.381,2.656,0.102,3.594 c0.836,0.945,1.328,2.066,1.328,3.226c0,2.697-1.904,4.684-5.894,5.097C18.199,20.49,19,22.1,19,23.313v2.734 c0,0.104-0.023,0.179-0.035,0.268C23.641,24.676,27,20.236,27,15C27,8.373,21.627,3,15,3z"></path>
                </svg>
            </span>
          </a>

          <a
            href="https://wa.me/51953708381"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="group flex items-center gap-4 bg-white p-4 rounded-full text-sm font-medium text-slate-900 transition hover:border-emerald-300 hover:bg-emerald-50 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:hover:bg-slate-900"
          >
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-3xl bg-[#25d366] text-white shadow-xl shadow-emerald-900/20 transition duration-300 hover:scale-105 dark:ring-slate-700/50">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6 fill-current">
                  <path d="M12.04 2a9.84 9.84 0 0 0-8.39 15l-1.1 4.03 4.13-1.08A9.84 9.84 0 1 0 12.04 2Zm0 17.95a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-2.45.64.65-2.39-.19-.31A8.08 8.08 0 1 1 20.12 12a8.09 8.09 0 0 1-8.08 7.95Zm4.43-6.05c-.24-.12-1.43-.71-1.65-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.47-.39-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.09 3.62.57.25 1.02.39 1.37.5.58.18 1.1.16 1.51.1.46-.07 1.43-.58 1.63-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"/>
                </svg>
            </span>
          </a>
        </div>
      </aside>
    </div>
  </main>

  <script is:inline>
    function submitContactForm(event) {
      event.preventDefault();
      const form = event.currentTarget;
      const name = form.name.value.trim();
      const email = form.email.value.trim();
      const message = form.message.value.trim();

      if (!name || !email || !message) {
        alert("Por favor completa todos los campos antes de enviar.");
        return false;
      }

      const subject = encodeURIComponent(`Contacto web desde ${name}`);
      const body = encodeURIComponent(`Nombre: ${name}\nEmail: ${email}\n\nMensaje:\n${message}`);
      window.location.href = `mailto:controlesjjcm2452@gmail.com?subject=${subject}&body=${body}`;
      return false;
    }
  </script>
</Rutas>